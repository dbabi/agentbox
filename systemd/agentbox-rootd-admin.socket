# Admin ops for root and agentbox-admin members (ARCHITECTURE.md §2.1).
# PID 1 binds it with this owner and mode; the service checks SO_PEERCRED on every connection.
# Generated from internal/sockets: go test ./internal/sockets -update
[Unit]
Description=agentbox socket /run/agentbox-rootd/rootd-admin.sock

[Socket]
ListenStream=/run/agentbox-rootd/rootd-admin.sock
SocketUser=root
SocketGroup=agentbox-admin
SocketMode=0660
DirectoryMode=0711
FileDescriptorName=admin
Service=agentbox-rootd.service

[Install]
WantedBy=sockets.target
