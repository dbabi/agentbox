# agentboxd's producer socket for agentbox-auditd (ARCHITECTURE.md §2.1).
# PID 1 binds it with this owner and mode; the service checks SO_PEERCRED on every connection.
# Generated from internal/sockets: go test ./internal/sockets -update
[Unit]
Description=agentbox socket /run/agentbox-audit/agentboxd.sock

[Socket]
ListenStream=/run/agentbox-audit/agentboxd.sock
SocketUser=agentbox-audit
SocketGroup=agentbox
SocketMode=0660
DirectoryMode=0711
FileDescriptorName=agentboxd
Service=agentbox-auditd.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
