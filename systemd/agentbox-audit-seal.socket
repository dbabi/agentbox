# audit.create and audit.seal from agentbox-auditd only (§9) (ARCHITECTURE.md §2.1).
# PID 1 binds it with this owner and mode; the service checks SO_PEERCRED on every connection.
# Generated from internal/sockets: go test ./internal/sockets -update
[Unit]
Description=agentbox socket /run/agentbox-rootd/audit-seal.sock

[Socket]
ListenStream=/run/agentbox-rootd/audit-seal.sock
SocketUser=root
SocketGroup=agentbox-audit
SocketMode=0660
DirectoryMode=0711
FileDescriptorName=audit-seal
Service=agentbox-rootd.service

[Install]
WantedBy=sockets.target
