# audit.create and audit.seal from agentbox-auditd only (ARCHITECTURE.md §9): only rootd can set +a and +i, so rootd
# serves audit.Files here.
# PID 1 binds it with this owner and mode; rootd checks SO_PEERCRED on every connection.
[Unit]
Description=agentbox audit seal socket

[Socket]
ListenStream=/run/agentbox-rootd/audit-seal.sock
SocketUser=root
SocketGroup=agentbox-audit
SocketMode=0660
DirectoryMode=0711
FileDescriptorName=audit-seal
Service=agentbox-rootd.service

[Install]
WantedBy=sockets.target
