# agentboxd's forwarded task ops, uid agentbox only (ARCHITECTURE.md §2.1).
# PID 1 binds it with this owner and mode; the service checks SO_PEERCRED on every connection.
# Generated from internal/sockets: go test ./internal/sockets -update
[Unit]
Description=agentbox socket /run/agentbox-rootd/rootd.sock

[Socket]
ListenStream=/run/agentbox-rootd/rootd.sock
SocketUser=agentbox
SocketGroup=agentbox
SocketMode=0600
DirectoryMode=0711
FileDescriptorName=rootd
Service=agentbox-rootd.service

[Install]
WantedBy=sockets.target
