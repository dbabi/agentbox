# Re-applies agentbox's persistent control store to whichever generation booted (ARCHITECTURE.md §3.2). Every agentbox
# unit but the firewall sets Requires= and After= on it. Never order it After=multi-user.target or agentbox-firstboot.service:
# agentbox-firstboot runs `systemctl start agentbox-reconcile.service` itself, and that nested start would wait forever.
# It also writes ntfy's config, ACLs and firewall drop-in, so it runs before ntfy (ARCHITECTURE.md §2, §3.3).
[Unit]
Description=agentbox reconcile
Before=ntfy.service
# its PREF64 drop-ins (ARCHITECTURE.md Appendix B check 2) need networkd up to reload it
After=systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/var/lib/agentbox/current/bin/agentbox reconcile

[Install]
WantedBy=multi-user.target
