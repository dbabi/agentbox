# agentbox-rootd (ARCHITECTURE.md §2): the root executor. Week 3: rootd.db, the activated sockets below with their
# SO_PEERCRED checks, the resolver that alone fills the broker dst sets (§6.1, Appendix B), audit segment creation and
# sealing (§9). READY=1 only once the nft sets match rootd.db, so brokers and user managers ordered after it never see
# a half-filled set. No IP sockets: resolution goes over resolved's Varlink (AF_UNIX), nft and conntrack over netlink.
[Unit]
Description=agentbox rootd
Requires=agentbox-reconcile.service agentbox-firewall.service
After=agentbox-reconcile.service agentbox-firewall.service systemd-resolved.service
Wants=systemd-resolved.service
# every firewall repair restarts it through Requires=; the start limit must never leave it down
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/var/lib/agentbox/current/bin/agentbox rootd
Sockets=agentbox-rootd-admin.socket agentbox-rootd-gate.socket agentbox-audit-seal.socket agentbox-rootd-resolve-proxy.socket agentbox-rootd-resolve-keys.socket agentbox-rootd-resolve-git.socket
# a crash restarts rootd alone: the default mode also restarts every user@ that Requires= it, which ends every running
# task and attach session (#218). An explicit restart still restarts them.
RestartMode=direct
Restart=on-failure
# a start check's refusal (rootd.ExitRefused) ends the start as failed: in direct mode a restart never ends the start
# job, so systemctl start and restart would hang for as long as rootd refuses (#256). A crash still restarts it.
RestartPreventExitStatus=78
RestartSec=2s
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# ProtectHome=yes without /run/user: rootd checks and removes each agent's stale podman pause.pid there (§4.2)
InaccessiblePaths=/home /root
ProtectKernelModules=yes
ProtectSystem=strict
# per-task socket dirs (§2.1); tasks launch through systemd-run, so their processes don't inherit this sandbox
ReadWritePaths=/var/lib/agentbox /run/agentbox-gate /run/agentbox-proxy /run/agentbox-keys /run/agentbox-git /run/agentbox-witness /run/user
PrivateTmp=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
# mknodat: the per-task witness FIFO (§5.6)
SystemCallFilter=mknodat
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
