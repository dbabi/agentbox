# git's producer socket for agentbox-auditd (ARCHITECTURE.md §2.1): agentbox-audit:agentbox-git 0660; auditd also checks the
# peer's uid with SO_PEERCRED. The dir comes from tmpfiles (0711).
[Unit]
Description=agentbox-auditd producer socket (git)

[Socket]
ListenStream=/run/agentbox-audit/git.sock
SocketUser=agentbox-audit
SocketGroup=agentbox-git
SocketMode=0660
FileDescriptorName=git
Service=agentbox-auditd.service
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
