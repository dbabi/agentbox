# Resolution requests from agentbox-proxy only (§6.3) (ARCHITECTURE.md §2.1).
# PID 1 binds it with this owner and mode; rootd checks SO_PEERCRED on every connection.
[Unit]
Description=agentbox rootd resolve-proxy socket

[Socket]
ListenStream=/run/agentbox-rootd/resolve-proxy.sock
SocketUser=root
SocketGroup=agentbox-proxy
SocketMode=0660
DirectoryMode=0711
FileDescriptorName=resolve-proxy
Service=agentbox-rootd.service

[Install]
WantedBy=sockets.target
