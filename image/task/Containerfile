# The task image (ARCHITECTURE.md §13, Appendix C): ubuntu:26.04, the apt tools, and mise's pinned tools.
# shortcut: Go, the package managers and git only; the CLIs (claude, codex, opencode), the rest of the apt list and
# Playwright join it with osbuild-image@ (weeks 11-12), which builds this file on the box.
FROM docker.io/library/ubuntu:26.04
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -qq -y --no-install-recommends \
      ca-certificates curl git python3 python3-pip nodejs npm >/dev/null && rm -rf /var/lib/apt/lists/*
# mise, pinned by version and SHA-256 (release v2026.11.9, SHASUMS256.txt)
ARG TARGETARCH
RUN set -e; case "$TARGETARCH" in \
      arm64) a=arm64 s=b8dd05af6447cee933928664982a8cb2fa646e6951cfc8539db23ce2554a7b04 ;; \
      amd64) a=x64 s=f13f3e5ec88807e0161669b3aa07a91d84478cdf1e95b5b92b63f85a25d42395 ;; \
      *) echo "no mise for $TARGETARCH" >&2; exit 1 ;; esac; \
    curl -fsSL -o /usr/local/bin/mise "https://github.com/jdx/mise/releases/download/v2026.11.9/mise-v2026.11.9-linux-$a"; \
    echo "$s  /usr/local/bin/mise" | sha256sum -c -; chmod 0755 /usr/local/bin/mise
COPY mise.toml /etc/mise/config.toml
# Tools live in the read-only image, never in the task's tmpfs HOME.
ENV MISE_DATA_DIR=/opt/mise MISE_CACHE_DIR=/tmp/mise-cache
RUN mise install --yes && ln -s "$(mise where go)/bin/go" "$(mise where go)/bin/gofmt" /usr/local/bin/ && rm -rf /tmp/mise-cache
# No DNS in a task (§4.2): nothing listens on 127.0.0.1:53, so a direct lookup fails in under 1 s. Tasks run with
# --network=none, so podman leaves this file as it is.
COPY resolv.conf /etc/resolv.conf
