# TEST FIXTURE, not shipped: stands in for the firewall area's unit (ARCHITECTURE.md §6.1) under the same name, so
# agentbox-rootd.service's Requires= and After= hold. hack/rootd-gate.sh installs it only when the release has none.
[Unit]
Description=agentbox firewall (rootd-gate stub)
DefaultDependencies=no
After=systemd-sysusers.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/agentbox-stub.nft

[Install]
WantedBy=multi-user.target
