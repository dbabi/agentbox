# TEST FIXTURE, not shipped: the part of ARCHITECTURE.md Appendix B that rootd's resolver writes to and the broker
# rules that make its sets matter, until the firewall area's `agentbox fw load` and agentbox-firewall.service merge
# (hack/rootd-gate.sh installs it as that unit). Same table, set names, types and flags; _ntfy's rules are left out
# because packaged ntfy is another area's. The private sets come from the same list as rootd's check
# (internal/rootd/resolve.Private4/Private6; hack/rootd_gate_test.go compares them).
add table inet agentbox
add chain inet agentbox output { type filter hook output priority filter; policy accept; }
flush chain inet agentbox output
table inet agentbox {
  set proxy_dst4 { typeof ip daddr . tcp dport; flags timeout; }
  set keys_dst4  { typeof ip daddr . tcp dport; flags timeout; }
  set git_dst4   { typeof ip daddr . tcp dport; flags timeout; }
  set proxy_dst6 { typeof ip6 daddr . tcp dport; flags timeout; }
  set keys_dst6  { typeof ip6 daddr . tcp dport; flags timeout; }
  set git_dst6   { typeof ip6 daddr . tcp dport; flags timeout; }
  set ntfy_dst4  { typeof ip daddr . tcp dport; flags timeout; }
  set ntfy_dst6  { typeof ip6 daddr . tcp dport; flags timeout; }
  set private4   { typeof ip daddr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
                   192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 } }
  set private6   { typeof ip6 daddr; flags interval; elements = { ::/127, ::ffff:0:0/96, 64:ff9b:1::/48, 100::/64, 2001:db8::/32, fc00::/7,
                   fe80::/10, fec0::/10, ff00::/8 } }
  chain output {
    type filter hook output priority filter; policy accept;
    ct direction original ct state established accept
    meta skuid { "agentbox-proxy", "agentbox-keys", "agentbox-git" } fib daddr type { local, broadcast, multicast, anycast } counter drop
    meta skuid { "agentbox-proxy", "agentbox-keys", "agentbox-git" } ip daddr @private4 counter drop
    meta skuid { "agentbox-proxy", "agentbox-keys", "agentbox-git" } ip6 daddr @private6 counter drop
    meta skuid "agentbox-proxy" ip daddr . tcp dport @proxy_dst4 accept
    meta skuid "agentbox-proxy" ip6 daddr . tcp dport @proxy_dst6 accept
    meta skuid "agentbox-proxy" counter drop
    meta skuid "agentbox-keys" ip daddr . tcp dport @keys_dst4 accept
    meta skuid "agentbox-keys" ip6 daddr . tcp dport @keys_dst6 accept
    meta skuid "agentbox-keys" counter drop
    meta skuid "agentbox-git" ip daddr . tcp dport @git_dst4 accept
    meta skuid "agentbox-git" ip6 daddr . tcp dport @git_dst6 accept
    meta skuid "agentbox-git" counter drop
  }
}
